# ============================================================================
# BILLCARE SALON SAAS — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to backend/.env and website/.env.local respectively

# --- Backend Configuration (backend/.env) ---
ENVIRONMENT=development
PORT=8000
DATABASE_URL=sqlite:///./billcare.db
# For PostgreSQL / Supabase in Production:
# DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Cryptographic Session Secrets
JWT_SECRET=billcare-enterprise-secret-key-replace-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# Razorpay POS & Payment Gateway
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
RAZORPAY_MERCHANT_VPA=billcare.pos@icici

# Meta WhatsApp Cloud API (Multi-Tenant Embedded Signup)
WHATSAPP_PHONE_NUMBER_ID=10982348911029
WHATSAPP_ACCESS_TOKEN=EAAG_PERMANENT_SYSTEM_USER_TOKEN
WHATSAPP_BUSINESS_ACCOUNT_ID=waba_enterprise_hub
WHATSAPP_WEBHOOK_VERIFY_TOKEN=billcare_meta_webhook_2026
META_GRAPH_API_VERSION=v20.0

# --- Frontend Configuration (website/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
