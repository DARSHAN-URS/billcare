# ============================================================
#  BillCare Backend — Environment Variables
#  Copy this file to .env and fill in your values.
#  In Railway: set these under Service → Variables
# ============================================================


# ── App ──────────────────────────────────────────────────────
# Set to "production" on Railway; keeps debug features off
ENVIRONMENT=production


# ── Database ─────────────────────────────────────────────────
# Railway PostgreSQL plugin auto-injects this variable.
# For Supabase, copy the Connection URI from:
#   Dashboard → Project Settings → Database → Connection string (URI)
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Supabase project URL (used by SDK / storage helpers)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co


# ── Auth (JWT) ────────────────────────────────────────────────
# Generate a secure random string: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=replace-with-a-very-long-random-secret-string


# ── Razorpay Payment Gateway ──────────────────────────────────
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# UPI VPA shown on POS QR receipts
RAZORPAY_MERCHANT_VPA=yourbusiness.pos@icici


# ── Meta / WhatsApp Cloud API ─────────────────────────────────
# Get from: Meta for Developers → WhatsApp → API Setup
# https://developers.facebook.com/apps/
WHATSAPP_PHONE_NUMBER_ID=1234567890123456
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_BUSINESS_ACCOUNT_ID=1234567890123456
# Any string you choose — must match what you set in Meta webhook config
WHATSAPP_WEBHOOK_VERIFY_TOKEN=billcare_meta_webhook_2026
META_GRAPH_API_VERSION=v20.0

# Meta App credentials (for webhook signature verification)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
