# ============================================================
#  BillCare Website (Next.js) — Environment Variables
#  Copy this file to .env.local and fill in your values.
#  In Netlify/Vercel: set these under Site → Environment Variables
# ============================================================


# ── Supabase ──────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-side only — never expose this to the client
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key


# ── Backend API ───────────────────────────────────────────────
# Public API URL used by the browser (proxied via Next.js /api rewrite)
NEXT_PUBLIC_API_URL=/api/v1
# Internal URL used by Next.js server-side to call the FastAPI backend
# On Railway: set to your Railway backend service URL, e.g. https://billcare-api.up.railway.app
BACKEND_INTERNAL_URL=http://localhost:8000


# ── Razorpay (Client-side) ────────────────────────────────────
# ONLY the Key ID is safe to expose in the browser (for checkout popup)
# Get from: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX

